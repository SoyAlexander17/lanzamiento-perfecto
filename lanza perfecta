-- Servicio para rastrear objetos del juego
local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- Función para buscar el aro en el mapa
local function obtenerAro()
    -- Busca el aro en la canasta (ajusta el nombre si el juego lo llama diferente)
    local aro = Workspace:FindFirstChild("Rim", true) or Workspace:FindFirstChild("Hoop", true) or Workspace:FindFirstChild("Goal", true)
    if aro and aro:IsA("BasePart") then
        return aro
    end
    return nil
end

-- Función para redirigir la pelota al aro
local function encestarPelota(pelota)
    local aro = obtenerAro()
    if aro and pelota then
        -- Espera un instante a que la física actúe y la teletransporta al aro
        task.wait(0.05)
        pelota.AssemblyLinearVelocity = Vector3.new(0, 0, 0) -- Detiene la fuerza original
        pelota.CFrame = aro.CFrame + Vector3.new(0, 2, 0) -- La coloca justo arriba del aro
    end
end

-- Detectar cuándo aparece una pelota en el juego
Workspace.DescendantAdded:Connect(function(objeto)
    -- Ajusta "Ball" por el nombre exacto que use la pelota en Basketball Zero
    if objeto.Name == "Ball" or objeto.Name == "Basketball" then
        encestarPelota(objeto)
    end
end)

print("¡Script de asistencia de tiro activado con éxito!")
